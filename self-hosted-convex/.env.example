# Copy to .env. Origins must be the public URLs Caddy serves, otherwise the
# backend and dashboard generate 127.0.0.1 links.
DOMAIN=fullstackaws.dev
CONVEX_CLOUD_ORIGIN=https://api.${DOMAIN}
CONVEX_SITE_ORIGIN=https://site.${DOMAIN}
NEXT_PUBLIC_DEPLOYMENT_URL=https://api.${DOMAIN}

# Keep these stable across reboots/redeploys or admin keys stop working.
# On EC2 fetch them from SSM Parameter Store in the userData script.
INSTANCE_NAME=convex
INSTANCE_SECRET=replace-with-64-hex-chars   # openssl rand -hex 32
