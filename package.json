{
  "name": "mnlth",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "bun scripts/dev.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "turbo typecheck",
    "sst:dev": "sst dev",
    "sst:deploy": "sst deploy",
    "sst:remove": "sst remove",
    "reset:aws": "bash scripts/reset-aws.sh",
    "convex:deploy": "bun scripts/convex-deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.4.0",
    "sst": "^4.17.1",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
