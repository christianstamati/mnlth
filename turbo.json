{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["VITE_CONVEX_URL", "VITE_STAGE_NAME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "setup-dev": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["@workspace/backend#setup-dev"],
      "cache": false,
      "persistent": true
    }
  }
}
