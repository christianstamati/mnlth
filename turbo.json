{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "VITE_CONVEX_URL",
    "VITE_STAGE_NAME",
    "VITE_GIT_SHA",
    "VITE_SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "setup-dev": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["@workspace/backend#setup-dev"],
      "cache": false,
      "persistent": true
    }
  }
}
