{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits", "group:allNonMajor"],
  "timezone": "Europe/Rome",
  "schedule": ["before 7am on monday"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Minor, patch and digest updates merge themselves once ci passes",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "The backend and its dashboard move together, by hand",
      "matchPackageNames": ["convex", "ghcr.io/get-convex/**"],
      "groupName": "convex",
      "automerge": false
    },
    {
      "description": "SST changes the deploy itself; read the notes first",
      "matchPackageNames": ["sst"],
      "automerge": false
    },
    {
      "matchPackageNames": ["@tanstack/**"],
      "groupName": "tanstack"
    },
    {
      "description": "Dependency PRs carry no changeset and need none",
      "matchPackageNames": ["*"],
      "addLabels": ["no changeset"]
    }
  ],
  "customManagers": [
    {
      "description": "The Caddy build the instance downloads at boot",
      "customType": "regex",
      "managerFilePatterns": ["/^infra/convex-backend\\.ts$/"],
      "matchStrings": [
        "caddy-linux-arm64/releases/download/(?<currentValue>v[0-9.]+)/"
      ],
      "depNameTemplate": "christianstamati/caddy-linux-arm64",
      "datasourceTemplate": "github-releases"
    }
  ]
}
