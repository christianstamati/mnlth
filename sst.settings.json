{
  "domain": "fullstackaws.dev",
  "region": "eu-central-1",
  "protect": ["production"],
  "monitored": ["production", "staging"],
  "removal": {
    "production": "retain",
    "*": "remove"
  },
  "database": {
    "*": "sqlite"
  },
  "storage": {
    "*": "volume"
  },
  "stages": {
    "main": "production",
    "staging": "staging"
  }
}
